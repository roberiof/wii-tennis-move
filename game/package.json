{
  "name": "wii-tennis-move-game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "start": "npm run build && vite preview",
    "tunnel": "cloudflared tunnel --protocol http2 --url http://localhost:4174",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "5.6.3",
    "vite": "^5.4.11",
    "vitest": "2.1.9"
  }
}
